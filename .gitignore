# =============================================================================
# Rust / Cargo
# =============================================================================
/target/
**/*.rs.bk

# =============================================================================
# Noter specific artifacts
# =============================================================================
# Local automation state is working data, never a canonical project artifact.
/.agent/

# Runtime and diagnostic logs stay out of the source tree history.
/logs/

# Python bytecode produced by repository validation tests
__pycache__/
*.py[cod]
/.venv/
/venv/
/.ruff_cache/
/.pytest_cache/
/.mypy_cache/
/.coverage
/.coverage.*
/htmlcov/

# Autosave and recovery artifacts
*.noter-autosave
*.noter-recover
noter-autosave-*
noter-recovery-*
*.tmp-noter
.noter-save-*.tmp
.noter-backup-*.bak

# Temporary files created during atomic saves
*.txt.tmp
*.md.tmp

# =============================================================================
# IDEs and editors
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-*

# =============================================================================
# OS generated files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# Build / distribution artifacts (cargo-dist, etc.)
# =============================================================================
/dist/
/artifacts/
*.msi
*.exe.bak
*.dmg
*.AppImage
*.deb
*.rpm
*.tar.gz
*.zip
*.cdx.xml

# =============================================================================
# Test / coverage artifacts
# =============================================================================
# Local proptest failure seeds; pin cases in source tests instead.
/proptest-regressions/
/coverage/
/lcov.info
coverage.xml
*.profraw
cobertura.xml
tarpaulin-report.html
/mutants.out*

# =============================================================================
# Environment and secrets
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
