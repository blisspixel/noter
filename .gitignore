# =============================================================================
# Rust / Cargo
# =============================================================================
/target/
**/*.rs.bk

# =============================================================================
# Noter specific artifacts
# =============================================================================
# Agent loop state is local working memory, never a canonical project artifact.
/.agent/

# Runtime and diagnostic logs stay out of the source tree history.
/logs/

# Python bytecode produced by repository validation tests
__pycache__/
*.py[cod]
/.ruff_cache/

# Autosave and recovery artifacts
*.noter-autosave
*.noter-recover
noter-autosave-*
noter-recovery-*
*.tmp-noter

# Temporary files created during atomic saves
*.txt.tmp
*.md.tmp

# =============================================================================
# Synchronized-folder development artifacts
# =============================================================================
# Build outputs are excluded because synchronized folders and antivirus tools can
# contend with Cargo's large collection of short-lived files.

# =============================================================================
# IDEs and editors
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-*

# =============================================================================
# OS generated files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# Build / distribution artifacts (cargo-dist, etc.)
# =============================================================================
/dist/
/artifacts/
*.msi
*.exe.bak
*.dmg
*.AppImage
*.deb
*.rpm
*.tar.gz
*.zip

# =============================================================================
# Test / coverage artifacts
# =============================================================================
/coverage/
/lcov.info
*.profraw
cobertura.xml
tarpaulin-report.html
/mutants.out*

# =============================================================================
# Environment and secrets
# =============================================================================
.env
.env.*
*.pem
*.key
secrets/
